// About Lastdrop. Shows Slint's AboutSlint widget: the condition of Slint's Royalty-free License
// 2.0 for a closed-source desktop app (ADR 0001, ARCHITECTURE "App"). Reachable from the tray
// menu ("About Lastdrop", R§10).

import { AboutSlint, Button, Palette } from "std-widgets.slint";

export component AboutWindow inherits Window {
    title: "About Lastdrop";
    // A fixed width: wrapped text needs it to know its height (the window is as tall as its
    // content).
    width: 420px;

    in property <string> version;
    in property <string> copyright: "© 2026 Adinosaur AB. All rights reserved.";
    // Third-party credit line (open-source components and their licences).
    in property <string> credits: "Built with Slint (Royalty-free License 2.0), jiff, serde, ureq and windows-rs (MIT / Apache-2.0). No telemetry: Lastdrop only talks to the services whose usage it reads.";
    // The content's height (the --preview-about render).
    out property <length> content-height: layout.preferred-height;
    // `close` would shadow Window's builtin close() (Slint 1.18), hence `dismiss`.
    callback dismiss();

    layout := VerticalLayout {
        padding: 24px;
        spacing: 12px;
        Text {
            text: "Lastdrop " + root.version;
            font-size: 20px;
            font-weight: 600;
            color: Palette.foreground;
        }
        Text {
            text: "How much AI is left in the tank, one click away.";
            color: Palette.foreground;
            wrap: word-wrap;
        }
        Text {
            text: root.copyright;
            color: Palette.foreground;
        }
        AboutSlint { }
        Text {
            text: root.credits;
            font-size: 12px;
            color: Palette.foreground.with-alpha(0.62);
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            Button {
                text: "Close";
                clicked => {
                    root.dismiss();
                }
            }
        }
    }
}
