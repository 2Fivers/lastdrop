// The hover card (readout-spec §8). Rust (lastdrop-core::readout::hovercard::HoverCardModel,
// converted in src/wiring.rs) fills these structs. Width 320, padding 12 (inner 296); height =
// content; when the content is taller than the space, Rust lowers `also-visible`, then clears
// `show-sentence` (R§8.1).

import { Theme, BarGeom, Tone, Glyph, GlyphData, PaceBar, GlyphIcon, ProviderGlyph } from "common.slint";

// One meter block (R§8.2). Window meters use elapsed-line/forecast/reset-line/reset-in; balance
// meters use left-line/forecast/rate-line/until. Empty strings are not shown.
export struct CardMeterData {
    is-balance: bool,
    name: string,
    value: string,
    value-semibold: bool,
    bar: BarGeom,
    tone: Tone,
    elapsed-line: string,
    forecast: string,
    forecast-semibold: bool,
    reset-line: string,
    reset-in: string,
    left-line: string,
    rate-line: string,
    until: string,
}

// One service section (R§8.2).
export struct CardServiceData {
    glyph: GlyphData,
    name: string,
    plan: string,
    age: string,
    meters: [CardMeterData],
}

// One "Also tracked" line (R§8.2): the time part of that meter's readout cell
// (lastdrop_core::readout::hovercard::AlsoTime). time-dim: the text's role is not TextPrimary
// (stale status, `–`); time-link: `Sign in` in AccentText.
export struct AlsoLineData {
    glyph: GlyphData,
    label: string,
    value: string,
    value-semibold: bool,
    time-glyph: Glyph,
    time-text: string,
    time-semibold: bool,
    time-dim: bool,
    time-link: bool,
}

// 12/16 text in the card.
component Small inherits Text {
    font-family: Theme.font-small;
    letter-spacing: Theme.small-tracking;
    font-size: 12px;
    color: Theme.text-secondary;
    vertical-alignment: center;
    accessible-role: none;
}

// R§8.2 meter block: margin-top 10. Row 16 (name, value); bar 296 × row 11 with 1 px above and
// below; tick line 16; reset line 16. Every window block shows both keys, every time.
component MeterBlock inherits VerticalLayout {
    in property <CardMeterData> data;
    padding-top: 10px;

    HorizontalLayout {
        height: 16px;
        Small {
            text: root.data.name;
            font-weight: 600;
            color: Theme.text-primary;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Small {
            text: root.data.value;
            font-weight: root.data.value-semibold ? 600 : 400;
            color: Theme.text-primary;
            horizontal-stretch: 0;
        }
    }
    VerticalLayout {
        padding-top: 1px;
        padding-bottom: 1px;
        PaceBar {
            geom: root.data.bar;
            tone: root.data.tone;
            calm-fill: Theme.text-primary;
        }
    }
    HorizontalLayout {
        height: 16px;
        // Tick key: a 1 × 9 px line in TextPrimary, 3 px left margin, 6 px right margin (R§8.2).
        if !root.data.is-balance: Rectangle {
            width: 10px;
            Rectangle {
                x: 3px;
                y: (parent.height - 9px) / 2;
                width: 1px;
                height: 9px;
                background: Theme.text-primary;
            }
        }
        Small {
            text: root.data.is-balance ? root.data.left-line : root.data.elapsed-line;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Small {
            text: root.data.forecast;
            font-weight: root.data.forecast-semibold ? 600 : 400;
            color: root.data.forecast-semibold ? Theme.text-primary : Theme.text-secondary;
            horizontal-stretch: 0;
        }
    }
    if !root.data.is-balance || root.data.rate-line != "" || root.data.until != "": HorizontalLayout {
        height: 16px;
        // Reset key: U+E777 at 11 px, 3 px right margin.
        if !root.data.is-balance: HorizontalLayout {
            padding-right: 3px;
            VerticalLayout {
                alignment: center;
                GlyphIcon {
                    glyph: Glyph.reset;
                    size: 11px;
                }
            }
        }
        Small {
            text: root.data.is-balance ? root.data.rate-line : root.data.reset-line;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Small {
            text: root.data.is-balance ? root.data.until : root.data.reset-in;
            horizontal-stretch: 0;
        }
    }
}

// The time column of one "Also tracked" line: glyph 12 + 2 + text, as in the readout cell.
component AlsoTime inherits HorizontalLayout {
    in property <AlsoLineData> line;
    spacing: 2px;
    alignment: start;
    if root.line.time-glyph != Glyph.none: VerticalLayout {
        alignment: center;
        GlyphIcon {
            glyph: root.line.time-glyph;
            size: root.line.time-glyph == Glyph.reset ? 11px : 12px;
        }
    }
    Small {
        text: root.line.time-text;
        font-weight: root.line.time-semibold ? 600 : 400;
        color: root.line.time-link ? Theme.link : root.line.time-dim ? Theme.stale : Theme.text-primary;
    }
}

export component HoverCard inherits Window {
    title: "Lastdrop";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    width: 320px;
    default-font-family: Theme.font-small;
    default-font-size: 12px;

    // The window height, set from Rust from content-height (logical px).
    in property <length> card-height: 200px;
    height: root.card-height;

    in property <Glyph> header-glyph: Glyph.none;
    in property <string> title-text;
    in property <string> sentence;
    in property <bool> show-sentence: true;
    in property <[CardServiceData]> services;
    in property <string> also-header;
    in property <[AlsoLineData]> also;
    // How many "Also tracked" lines fit (R§8.1 drops lines from the bottom first).
    in property <int> also-visible: 4;
    in property <string> also-more;
    // UIA ToolTip name: title + sentence (R§11).
    in property <string> uia-name;
    out property <length> content-height: content.preferred-height;

    // A click that reaches the card hides it (R§8.1).
    callback clicked();

    // The "Also tracked" time column is as wide as its widest entry and at least 56 px (R§8.2):
    // measured on a copy outside the layout.
    property <length> also-time-width: max(56px, time-probe.preferred-width);

    Rectangle {
        background: Theme.window-fill;
        border-width: Theme.high-contrast ? 1px : 0px;
        border-color: Theme.hc-window-text;
    }
    TouchArea {
        clicked => {
            root.clicked();
        }
    }
    Rectangle {
        width: 0px;
        height: 0px;
        accessible-role: text;
        accessible-label: root.uia-name;
        time-probe := VerticalLayout {
            visible: false;
            for line in root.also: AlsoTime {
                line: line;
            }
        }
    }

    content := VerticalLayout {
        padding: 12px;
        // Header: severity glyph 16 (cell 16 × 20) + 8 + title 14/20 semibold.
        HorizontalLayout {
            spacing: root.header-glyph == Glyph.none ? 0px : 8px;
            VerticalLayout {
                alignment: start;
                Rectangle {
                    width: root.header-glyph == Glyph.none ? 0px : 16px;
                    height: 20px;
                    GlyphIcon {
                        glyph: root.header-glyph;
                        size: 16px;
                    }
                }
            }
            Text {
                text: root.title-text;
                font-family: Theme.font-text;
                font-size: 14px;
                font-weight: 600;
                color: Theme.text-primary;
                wrap: word-wrap;
                horizontal-stretch: 1;
                accessible-role: none;
            }
        }
        if root.show-sentence && root.sentence != "": VerticalLayout {
            padding-top: 4px;
            Text {
                text: root.sentence;
                font-family: Theme.font-small;
                letter-spacing: Theme.small-tracking;
                font-size: 12px;
                color: Theme.text-primary;
                wrap: word-wrap;
                accessible-role: none;
            }
        }
        // Service sections: margin-top 12, divider, padding-top 10; service row 16.
        for service in root.services: VerticalLayout {
            padding-top: 12px;
            Rectangle {
                height: 1px;
                background: Theme.divider;
            }
            HorizontalLayout {
                padding-top: 10px;
                HorizontalLayout {
                    height: 16px;
                    spacing: 6px;
                    ProviderGlyph {
                        glyph: service.glyph;
                        size: 16px;
                    }
                    Small {
                        text: service.name;
                        font-weight: 600;
                        color: Theme.text-primary;
                        horizontal-stretch: 0;
                    }
                    Small {
                        text: service.plan;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Small {
                        text: service.age;
                        horizontal-stretch: 0;
                    }
                }
            }
            for meter in service.meters: MeterBlock {
                data: meter;
            }
        }
        // Also tracked: margin-top 12, divider, padding-top 10; header; 20 px lines.
        if root.also.length > 0 && root.also-visible > 0: VerticalLayout {
            padding-top: 12px;
            Rectangle {
                height: 1px;
                background: Theme.divider;
            }
            VerticalLayout {
                padding-top: 10px;
                Small {
                    height: 16px;
                    text: root.also-header;
                }
            }
            for line[i] in root.also: HorizontalLayout {
                height: i < root.also-visible ? 20px : 0px;
                visible: i < root.also-visible;
                VerticalLayout {
                    alignment: center;
                    ProviderGlyph {
                        glyph: line.glyph;
                        size: 12px;
                    }
                }
                Rectangle {
                    width: 6px;
                }
                Small {
                    text: line.label;
                    color: Theme.text-primary;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Small {
                    text: line.value;
                    font-weight: line.value-semibold ? 600 : 400;
                    color: Theme.text-primary;
                    horizontal-stretch: 0;
                }
                Rectangle {
                    width: 8px;
                }
                AlsoTime {
                    width: root.also-time-width;
                    line: line;
                }
            }
            if root.also-more != "": Small {
                height: 20px;
                text: root.also-more;
            }
        }
    }
}
