// Shared UI pieces: theme tokens, the pace bar, glyphs (flyout-spec §11; readout-spec §6.6, §6.7, §7).
//
// Nothing in .slint formats a number or a time (F§0): every string and every pixel of a bar or a
// sparkline comes from Rust (lastdrop-core), computed at the window's scale.
//
// Geometry crosses the Rust/Slint boundary as plain floats in DEVICE pixels: a `length` set from
// Rust is interpreted as logical px, which would rescale and re-round it. The .slint side converts
// with `* 1phx` (F§11).
//
// Licence rule (ARCHITECTURE "App"): themes, layouts and provider definitions are data passed in
// from Rust, never .slint code loaded at runtime.

// WinUI 3 theme resources, set from Rust per window (each window has its own instance of a global).
// Mode = the Windows mode (SystemUsesLightTheme), like the other tray flyouts (F§1.1).
export global Theme {
    in property <bool> dark: false;
    in property <bool> high-contrast: false;
    // Resolved by lastdrop-win's palette and set from Rust (accent shades, high-contrast colours).
    in property <color> accent-fill: #005fb8;
    in property <color> accent-text: #003e92;
    in property <color> hc-window: #000000;
    in property <color> hc-window-text: #ffffff;
    in property <color> hc-highlight: #1aebff;
    in property <color> hc-highlight-text: #000000;
    in property <color> hc-gray-text: #a6a6a6;
    in property <color> hc-hotlight: #75e9fc;
    // What the window paints under its content. Transparent in the app: DWM draws the acrylic
    // backdrop or its solid fallback (F§1.1). The --preview-flyout render sets the solid fallback
    // (#F9F9F9 / #2C2C2C, F§7) so the PNG looks like the window with transparency off.
    in property <color> solid-backdrop: transparent;
    // Focus rectangles only after keyboard use (F§9, as WinUI): set by the windows' key handlers,
    // cleared on pointer input.
    in-out property <bool> keyboard-focus-visible: false;

    in property <string> font-small: "Segoe UI Variable Small";
    in property <string> font-text: "Segoe UI Variable Text";
    in property <string> font-display: "Segoe UI Variable Display";
    in property <string> font-icons: "Segoe Fluent Icons";
    // Segoe UI Variable is one variable font; Slint 1.18's text stack selects its families but
    // not the optical-size axis of the named instances, so "Small" renders with the Text
    // instance's tighter fit. Measured against the mock (Edge, 12 px): +0.18 px per character
    // brings 12/16 text to the Small instance's widths (F§8). Applied to every 12 px text.
    in property <length> small-tracking: 0.18px;

    out property <color> text-primary: high-contrast ? hc-window-text : dark ? #ffffff : #000000e4;
    out property <color> text-secondary: high-contrast ? hc-window-text : dark ? #ffffffc5 : #0000009e;
    out property <color> text-tertiary: high-contrast ? hc-window-text : dark ? #ffffff87 : #00000072;
    out property <color> text-disabled: high-contrast ? hc-gray-text : dark ? #ffffff5d : #0000005c;
    out property <color> stale: high-contrast ? hc-gray-text : text-secondary;
    out property <color> track: high-contrast ? hc-window-text : dark ? #ffffff8b : #00000072;
    out property <color> caution: high-contrast ? hc-highlight : dark ? #fce100 : #9d5d00;
    out property <color> critical: high-contrast ? hc-highlight : dark ? #ff99a4 : #c42b1c;
    out property <color> success: high-contrast ? hc-highlight : dark ? #6ccb5f : #0f7b0f;
    out property <color> on-accent: high-contrast ? hc-highlight-text : dark ? #000000 : #ffffff;
    // F§7 high contrast: the flyout's meter fill is COLOR_HIGHLIGHT at every severity.
    out property <color> accent: high-contrast ? hc-highlight : accent-fill;
    out property <color> link: high-contrast ? hc-hotlight : accent-text;
    out property <color> card-fill: high-contrast ? transparent : dark ? #ffffff0d : #ffffffb3;
    out property <color> card-stroke: high-contrast ? hc-window-text : dark ? #00000019 : #0000000f;
    out property <color> subtle-hover: dark ? #ffffff0f : #00000009;
    out property <color> subtle-pressed: dark ? #ffffff0a : #00000006;
    out property <color> divider: high-contrast ? hc-window-text : dark ? #ffffff15 : #0000000f;
    out property <color> badge-fill: high-contrast ? transparent : dark ? #ffffff0f : #0000000f;
    out property <color> footer-fill: high-contrast ? transparent : dark ? #00000030 : #0000000a;
    out property <color> focus-outer: high-contrast ? hc-highlight : dark ? #ffffff : #000000e4;
    out property <color> focus-inner: high-contrast ? hc-window : dark ? #000000b3 : #ffffffb3;
    // F§9: 2 px focus stroke in contrast themes (COLOR_HIGHLIGHT 2 px).
    out property <length> focus-width: 2px;
    out property <color> window-fill: high-contrast ? hc-window : solid-backdrop;
}

// One span of device pixels, relative to the bar's origin.
export struct Seg { x: float, w: float }

// The pace bar in device px, from lastdrop_core::readout::bar_geometry (R§6.6). `dashed`: the fill
// is already split into dashes.
export struct BarGeom {
    track: [Seg],
    fill: [Seg],
    tick-x: float,
    has-tick: bool,
    hair: float,
    fill-h: float,
    tick-h: float,
    y-track: float,
    height: float,
    round-start: bool,
    round-end: bool,
    dashed: bool,
}

// Colour family of a bar, a say-glyph or a verdict (F§11). `calm` = no glyph.
export enum Tone { calm, caution, critical, stale }

// Which glyph to draw (R§6.7). `none` draws nothing.
export enum Glyph { none, reset, warning, critical, success, info, stale }

// One sparkline column, device px relative to the sparkline box (F§6).
export struct SparkCol { x: float, h: float, today: bool }

// The 14-day sparkline (F§6), device px. The baseline runs from base-x over base-w, `hair` high.
export struct SparkData {
    cols: [SparkCol],
    dim: bool,
    a11y: string,
    box-w: float,
    box-h: float,
    col-w: float,
    hair: float,
    base-x: float,
    base-w: float,
}

// One fill segment of a pace bar. Rounded outer ends (WinUI ProgressBar indicator) per F§11's
// fallback for renderers without per-corner radii: the whole segment is a rounded rectangle and a
// square patch covers the rounded corners of an end that must stay square (a gap or a dash).
component FillSeg inherits Rectangle {
    in property <float> seg-x;
    in property <float> seg-w;
    in property <float> fill-h;
    in property <float> top;
    in property <bool> round-left;
    in property <bool> round-right;
    in property <color> fill-color;
    // Device px covered by one rounded end: ceil(fill-h / 2), at most the segment's width.
    property <float> cap: min(root.seg-w, ceil(root.fill-h / 2));
    x: root.seg-x * 1phx;
    y: root.top * 1phx;
    width: root.seg-w * 1phx;
    height: root.fill-h * 1phx;

    Rectangle {
        background: root.fill-color;
        border-radius: (root.round-left || root.round-right) ? min(root.seg-w, root.fill-h) / 2 * 1phx : 0px;
    }
    if (root.round-left || root.round-right) && !root.round-left: Rectangle {
        x: 0px;
        width: root.cap * 1phx;
        background: root.fill-color;
    }
    if (root.round-left || root.round-right) && !root.round-right: Rectangle {
        x: (root.seg-w - root.cap) * 1phx;
        width: root.cap * 1phx;
        background: root.fill-color;
    }
}

// R§6.6: rectangles at device pixels; all segments are children of one element so any sub-pixel
// offset of the layout applies to all of them alike.
export component PaceBar inherits Rectangle {
    in property <BarGeom> geom;
    in property <Tone> tone: Tone.calm;
    // The calm fill: AccentFill in the flyout, TextPrimary in the hover card (R§6.6).
    in property <color> calm-fill: Theme.accent;
    height: root.geom.height * 1phx;
    accessible-role: none;

    property <color> fill-color: Theme.high-contrast && root.tone != Tone.stale ? root.calm-fill
        : root.tone == Tone.caution ? Theme.caution
        : root.tone == Tone.critical ? Theme.critical
        : root.tone == Tone.stale ? Theme.stale : root.calm-fill;

    for seg in root.geom.track: Rectangle {
        x: seg.x * 1phx;
        y: root.geom.y-track * 1phx;
        width: seg.w * 1phx;
        height: root.geom.hair * 1phx;
        background: Theme.track;
    }
    for seg[i] in root.geom.fill: FillSeg {
        seg-x: seg.x;
        seg-w: seg.w;
        fill-h: root.geom.fill-h;
        top: root.geom.y-track - (root.geom.fill-h - root.geom.hair) / 2;
        round-left: !root.geom.dashed && i == 0 && root.geom.round-start;
        round-right: !root.geom.dashed && i == root.geom.fill.length - 1 && root.geom.round-end;
        fill-color: root.fill-color;
    }
    if root.geom.has-tick: Rectangle {
        x: root.geom.tick-x * 1phx;
        y: (root.geom.y-track - (root.geom.tick-h - root.geom.hair) / 2) * 1phx;
        width: root.geom.hair * 1phx;
        height: root.geom.tick-h * 1phx;
        background: root.tone == Tone.stale ? Theme.stale : Theme.text-primary;
    }
}

// A stacked severity glyph or the reset glyph in Segoe Fluent Icons (R§6.7).
export component GlyphIcon inherits Rectangle {
    in property <Glyph> glyph;
    in property <length> size: 12px;
    // The reset glyph's colour (TextSecondary in rows and keys).
    in property <color> reset-color: Theme.text-secondary;
    width: root.glyph == Glyph.none ? 0px : root.size;
    height: root.size;
    accessible-role: none;

    property <string> outer: root.glyph == Glyph.warning ? "\u{F139}"
        : root.glyph == Glyph.stale ? "\u{F140}"
        : root.glyph == Glyph.reset ? "\u{E777}"
        : root.glyph == Glyph.none ? "" : "\u{F136}";
    property <string> mark: root.glyph == Glyph.warning ? "\u{F13B}"
        : root.glyph == Glyph.critical ? "\u{F13C}"
        : root.glyph == Glyph.success ? "\u{F13E}"
        : root.glyph == Glyph.info ? "\u{F13F}" : "";
    property <color> outer-color: root.glyph == Glyph.warning ? Theme.caution
        : root.glyph == Glyph.critical ? Theme.critical
        : root.glyph == Glyph.success ? Theme.success
        : root.glyph == Glyph.info ? Theme.accent
        : root.glyph == Glyph.stale ? Theme.stale : root.reset-color;

    if root.outer != "": Text {
        text: root.outer;
        font-family: Theme.font-icons;
        font-size: root.size;
        color: root.outer-color;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.mark != "": Text {
        text: root.mark;
        font-family: Theme.font-icons;
        font-size: root.size;
        color: Theme.on-accent;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A provider glyph (R§6.4, R Appendix A), from src/wiring.rs `glyph_data`: either SVG path
// commands on the 12 × 12 grid with their stroke width in grid units (Claude 1.35, Codex 1.05,
// Meshy 1.05) and their caps and joins, or a monogram (one or two letters) for a service without
// a drawing.
export struct GlyphData { commands: string, stroke: float, round-caps: bool, round-joins: bool, monogram: string }

// Stroked in TextPrimary. Needs Slint's software-renderer-path feature.
export component ProviderGlyph inherits Rectangle {
    in property <GlyphData> glyph;
    in property <length> size: 16px;
    width: root.size;
    height: root.size;
    accessible-role: none;

    if root.glyph.commands != "": Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: root.glyph.commands;
        fill: transparent;
        stroke: Theme.text-primary;
        stroke-width: root.glyph.stroke * root.size / 12;
        stroke-line-cap: root.glyph.round-caps ? LineCap.round : LineCap.butt;
        stroke-line-join: root.glyph.round-joins ? LineJoin.round : LineJoin.miter;
    }
    // Monogram (R§6.4): 1 px rounded square r 2.5 (at 12 px), letter Small 8 px semibold, two
    // letters at 7 px.
    if root.glyph.monogram != "": Rectangle {
        border-width: 1px;
        border-radius: 2.5px * root.size / 12px;
        border-color: Theme.text-primary;
        Text {
            text: root.glyph.monogram;
            font-family: Theme.font-small;
            letter-spacing: Theme.small-tracking;
            font-size: (root.glyph.monogram.character-count > 1 ? 7px : 8px) * root.size / 12px;
            font-weight: 600;
            color: Theme.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// The 14-day sparkline (F§6).
export component Sparkline inherits Rectangle {
    in property <SparkData> data;
    width: root.data.box-w * 1phx;
    height: root.data.box-h * 1phx;
    accessible-role: image;
    accessible-label: root.data.a11y;

    Rectangle {
        x: root.data.base-x * 1phx;
        y: (root.data.box-h - root.data.hair) * 1phx;
        width: root.data.base-w * 1phx;
        height: root.data.hair * 1phx;
        background: Theme.text-disabled;
    }
    for col in root.data.cols: Rectangle {
        x: col.x * 1phx;
        y: (root.data.box-h - col.h) * 1phx;
        width: root.data.col-w * 1phx;
        height: col.h * 1phx;
        background: col.today && !root.data.dim ? Theme.accent : Theme.text-tertiary;
    }
}

// The keyboard focus rectangle (F§9): 2 px FocusStrokeColorOuter outside + 1 px
// FocusStrokeColorInner, radius = element radius + 2. Place it as the last child of the focused
// element with `x: -2px; y: -2px; width: parent.width + 4px; height: parent.height + 4px;` so it
// extends 2 px outside.
export component FocusRect inherits Rectangle {
    in property <length> radius: 4px;
    border-width: Theme.focus-width;
    border-color: Theme.focus-outer;
    border-radius: root.radius + 2px;
    Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-width: 1px;
        border-color: Theme.focus-inner;
        border-radius: root.radius;
    }
}

// The 16 px indeterminate progress ring (F§3), accent. Drawn as an arc that turns; it only runs
// while visible, and the flyout is the only place it appears.
export component ProgressRing inherits Rectangle {
    accessible-role: progress-indicator;
    property <angle> turn: mod(animation-tick() / 1.2s, 1) * 360deg;
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 16;
        viewbox-height: 16;
        fill: transparent;
        stroke: Theme.accent;
        stroke-width: 2px;
        stroke-line-cap: LineCap.round;
        // A 3/4 arc of radius 7 starting at the angle `turn`.
        commands: "M " + (8 + 7 * cos(root.turn)) + " " + (8 + 7 * sin(root.turn))
            + " A 7 7 0 1 1 " + (8 + 7 * cos(root.turn - 90deg)) + " " + (8 + 7 * sin(root.turn - 90deg));
    }
}

// A subtle button (F§5 Settings, F§3 refresh): hover SubtleFillColorSecondary, pressed
// SubtleFillColorTertiary with the label in TextSecondary (F§9).
export component SubtleButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> accessible-name: root.label;
    in property <bool> enabled: true;
    // An indeterminate 16 px progress ring (accent) replaces the icon (F§3, the refresh button).
    in property <bool> busy: false;
    // The pointer is over the button (the refresh tooltip, F§9).
    out property <bool> hovered: touch.has-hover;
    callback clicked();
    height: 32px;
    min-width: 32px;
    border-radius: 4px;
    background: touch.pressed && root.enabled ? Theme.subtle-pressed : touch.has-hover && root.enabled ? Theme.subtle-hover : transparent;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        root.clicked();
    }
    forward-focus: focus;

    property <color> fg: touch.pressed ? Theme.text-secondary : Theme.text-primary;

    HorizontalLayout {
        padding-left: root.label == "" ? 8px : 11px;
        padding-right: root.label == "" ? 8px : 11px;
        spacing: 8px;
        alignment: center;
        Rectangle {
            width: 16px;
            if !root.busy: Text {
                text: root.icon;
                font-family: Theme.font-icons;
                font-size: 16px;
                color: root.fg;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if root.busy: ProgressRing {
                width: 16px;
                height: 16px;
            }
        }
        if root.label != "": Text {
            text: root.label;
            font-family: Theme.font-text;
            font-size: 14px;
            color: root.fg;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    if focus.has-focus && Theme.keyboard-focus-visible: FocusRect {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        radius: 4px;
    }
}

// A hyperlink button (F§4.3 message actions, F§5 footer link): AccentTextFillColorPrimary.
export component HyperlinkButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }
    forward-focus: focus;
    min-width: label.preferred-width;
    preferred-width: label.preferred-width;
    height: 16px;

    label := Text {
        text: root.text;
        font-family: Theme.font-small;
        letter-spacing: Theme.small-tracking;
        font-size: 12px;
        color: touch.pressed ? Theme.text-secondary : Theme.link;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    if focus.has-focus && Theme.keyboard-focus-visible: FocusRect {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        radius: 2px;
    }
}
