// Settings window: M1 "settings basics" (ROADMAP M1). The settings design is out of scope of both
// specs (F§12); this is a plain Windows 11 (fluent) window following the app theme. API keys
// (Meshy, OpenCode Go) are passed to Rust once and stored in Credential Manager, never kept in a
// property, never shown again and never written to settings.json. Every text comes from Rust
// (`texts`, the `settings.*` strings) in the chosen language.

import { Button, CheckBox, LineEdit, ComboBox, ScrollView, Switch, GroupBox, Palette } from "std-widgets.slint";

export struct ProviderRow {
    id: string,
    name: string,
    enabled: bool,
}

// One meter of an enabled service (settings `hidden_meters`, F§2.2; readout pins, R§4.3).
// label: the meter with its service (`settings.meter`: `Claude weekly`, `Veckogränsen för
// Claude`); pinned: one of the 1–2 readout pins (Rust keeps at most two, in the order picked).
export struct MeterChoice {
    label: string,
    shown: bool,
    pinned: bool,
}

// The API key of one service (Meshy, OpenCode Go): its name, the box's placeholder, and whether
// a key is stored. The key itself is never shown or kept here.
export struct ApiKeyRow {
    title: string,
    placeholder: string,
    stored: bool,
}

// One account of Claude Code or Codex (accounts-spec §7): its name (alias, e-mail or
// `Account 2`), its folder, who is signed in there, its alias as typed, and whether it may be
// removed (not the last one of its service).
export struct AccountRow {
    name: string,
    folder: string,
    status: string,
    alias: string,
    removable: bool,
}

// A folder found on this PC that is not an account yet (accounts-spec §6).
export struct FoundFolder {
    folder: string,
    status: string,
}

// The accounts of one service, with its folders found on this PC.
export struct AccountBlock {
    title: string,
    accounts: [AccountRow],
    found: [FoundFolder],
}

// The window's fixed texts (`settings.*` strings), from Rust.
export struct SettingsTexts {
    title: string,
    heading: string,
    services: string,
    services-hint: string,
    accounts: string,
    accounts-hint: string,
    accounts-alias: string,
    accounts-alias-none: string,
    accounts-remove: string,
    accounts-found: string,
    accounts-add: string,
    accounts-add-folder: string,
    accounts-new: string,
    accounts-new-name: string,
    accounts-new-create: string,
    privacy-hide: string,
    key: string,
    key-save: string,
    key-remove: string,
    key-hint: string,
    refresh: string,
    refresh-check: string,
    readout: string,
    readout-show: string,
    readout-rows: string,
    readout-auto: string,
    readout-pinned: string,
    readout-times: string,
    readout-clock: string,
    readout-relative: string,
    meters-hint: string,
    meter-show: string,
    meter-pin: string,
    notify: string,
    notify-on: string,
    notify-levels: string,
    notify-and: string,
    notify-used-up: string,
    notify-resets: string,
    notify-low: string,
    notify-hint: string,
    shortcut: string,
    shortcut-on: string,
    shortcut-ctrl: string,
    shortcut-alt: string,
    shortcut-shift: string,
    shortcut-win: string,
    shortcut-key: string,
    language: string,
    language-hint: string,
    startup: string,
    startup-on: string,
    apply: string,
    close: string,
}

component SectionTitle inherits Text {
    font-size: 14px;
    font-weight: 600;
    color: Palette.foreground;
}

component Hint inherits Text {
    font-size: 12px;
    color: Palette.foreground.with-alpha(0.62);
    wrap: word-wrap;
}

export component SettingsWindow inherits Window {
    title: root.texts.title;
    preferred-width: 480px;
    preferred-height: 640px;
    min-width: 400px;
    min-height: 360px;

    in property <SettingsTexts> texts;
    in-out property <[ProviderRow]> providers;
    // Claude Code's and Codex's accounts (accounts-spec §7), one block per service.
    in property <[AccountBlock]> account-blocks;
    // Hide personal info (accounts-spec §4); Rust renames the accounts when it is toggled.
    in property <bool> hide-personal-info;
    // Refresh interval: index into interval-choices ("Manual", "1 min", …), localized by Rust.
    in property <[string]> interval-choices;
    in-out property <int> interval-index;
    in-out property <bool> readout-enabled;
    // Readout content (R§4.3): 0 auto, 1 pinned meters.
    in-out property <int> readout-content-index;
    // "Show times as" (R§5.2): 0 clock times, 1 time remaining.
    in-out property <int> time-style-index;
    in property <[MeterChoice]> meters;
    // Scroll to and highlight the pins (tray menu "Taskbar readout ▸ Pinned meters…", R§10).
    in property <bool> focus-pins;
    // Notifications (N§2): on/off, two levels (indices into level-choices: "Off", "50%", …),
    // used up, resets and low balances.
    in-out property <bool> notify-enabled;
    in property <[string]> level-choices;
    in-out property <int> notify-first-index;
    in-out property <int> notify-second-index;
    in-out property <bool> notify-used-up;
    in-out property <bool> notify-resets;
    in-out property <bool> notify-low-balance;
    in-out property <bool> start-with-windows;
    // The language of Lastdrop's texts: index into language-choices ("Same as Windows (…)", then
    // each language by its own name), from Rust.
    in property <[string]> language-choices;
    in-out property <int> language-index;
    // The services read with an API key the user stores here.
    in property <[ApiKeyRow]> api-keys;
    // The global hotkey (R§10, off by default): modifiers and one key (a letter, a digit or
    // F1…F24).
    in-out property <bool> hotkey-enabled;
    in-out property <bool> hotkey-ctrl;
    in-out property <bool> hotkey-alt;
    in-out property <bool> hotkey-shift;
    in-out property <bool> hotkey-win;
    in-out property <string> hotkey-key;
    // A problem to show under the hotkey (`the shortcut is already in use`).
    in property <string> hotkey-error;
    // One line under the buttons: what Apply did or why it could not.
    in property <string> status-text;

    callback provider-toggled(int, bool);
    // Accounts: (block, row) of an account or a found folder; a block for the folder picker and
    // for a new account with its name.
    callback account-alias-edited(int, int, string);
    callback account-removed(int, int);
    callback found-added(int, int);
    callback add-folder(int);
    callback new-account(int, string);
    callback privacy-toggled(bool);
    callback meter-shown-toggled(int, bool);
    callback meter-pinned-toggled(int, bool);
    // Store (row, key) and remove (row) an API key.
    callback set-api-key(int, string);
    callback clear-api-key(int);
    callback apply();
    // `close` would shadow Window's builtin close() (Slint 1.18), hence `dismiss`.
    callback dismiss();

    // Scrolls the readout section into view (focus-pins).
    public function show-pins() {
        sv.content-y = -readout-section.y;
    }

    // Scrolls the accounts section into view (first run, accounts-spec §6).
    public function show-accounts() {
        sv.content-y = -accounts-section.y;
    }

    VerticalLayout {
        sv := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            content-height: page.preferred-height;
            page := VerticalLayout {
                width: sv.visible-width;
                padding: 24px;
                spacing: 16px;

                Text {
                    text: root.texts.heading;
                    font-size: 20px;
                    font-weight: 600;
                    color: Palette.foreground;
                }

                // Services: on/off; Meshy needs an API key.
                VerticalLayout {
                    spacing: 8px;
                    SectionTitle {
                        text: root.texts.services;
                    }
                    for row[i] in root.providers: CheckBox {
                        text: row.name;
                        checked: row.enabled;
                        toggled => {
                            root.provider-toggled(i, self.checked);
                        }
                    }
                    Hint {
                        text: root.texts.services-hint;
                    }
                }

                // Accounts of Claude Code and Codex (accounts-spec §7).
                accounts-section := VerticalLayout {
                    spacing: 8px;
                    SectionTitle {
                        text: root.texts.accounts;
                    }
                    Hint {
                        text: root.texts.accounts-hint;
                    }
                    for block[b] in root.account-blocks: VerticalLayout {
                        spacing: 6px;
                        padding-top: 4px;
                        Text {
                            text: block.title;
                            font-weight: 600;
                            color: Palette.foreground;
                        }
                        for account[a] in block.accounts: Rectangle {
                            border-radius: 4px;
                            background: Palette.alternate-background;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text {
                                            text: account.name;
                                            color: Palette.foreground;
                                            overflow: elide;
                                        }
                                        Hint {
                                            text: account.folder;
                                            wrap: no-wrap;
                                            overflow: elide;
                                        }
                                        Hint {
                                            text: account.status;
                                        }
                                    }
                                    if account.removable: VerticalLayout {
                                        alignment: start;
                                        Button {
                                            text: root.texts.accounts-remove;
                                            clicked => {
                                                root.account-removed(b, a);
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: root.texts.accounts-alias;
                                        vertical-alignment: center;
                                        color: Palette.foreground;
                                    }
                                    LineEdit {
                                        text: account.alias;
                                        placeholder-text: root.texts.accounts-alias-none;
                                        horizontal-stretch: 1;
                                        edited(text) => {
                                            root.account-alias-edited(b, a, text);
                                        }
                                    }
                                }
                            }
                        }
                        if block.found.length > 0: Hint {
                            text: root.texts.accounts-found;
                        }
                        for found[f] in block.found: HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: found.folder;
                                    color: Palette.foreground;
                                    overflow: elide;
                                }
                                Hint {
                                    text: found.status;
                                }
                            }
                            Button {
                                text: root.texts.accounts-add;
                                clicked => {
                                    root.found-added(b, f);
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: root.texts.accounts-add-folder;
                                clicked => {
                                    root.add-folder(b);
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: root.texts.accounts-new;
                                vertical-alignment: center;
                                color: Palette.foreground;
                            }
                            new-name := LineEdit {
                                placeholder-text: root.texts.accounts-new-name;
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: root.texts.accounts-new-create;
                                enabled: new-name.text != "";
                                clicked => {
                                    root.new-account(b, new-name.text);
                                    new-name.text = "";
                                }
                            }
                        }
                    }
                    CheckBox {
                        text: root.texts.privacy-hide;
                        checked: root.hide-personal-info;
                        toggled => {
                            root.privacy-toggled(self.checked);
                        }
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    SectionTitle {
                        text: root.texts.key;
                    }
                    for row[i] in root.api-keys: VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: row.title;
                            color: Palette.foreground;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            key := LineEdit {
                                placeholder-text: row.placeholder;
                                input-type: password;
                                horizontal-stretch: 1;
                                accepted => {
                                    if (self.text != "") {
                                        root.set-api-key(i, self.text);
                                        self.text = "";
                                    }
                                }
                            }
                            Button {
                                text: root.texts.key-save;
                                enabled: key.text != "";
                                clicked => {
                                    root.set-api-key(i, key.text);
                                    key.text = "";
                                }
                            }
                            if row.stored: Button {
                                text: root.texts.key-remove;
                                clicked => {
                                    root.clear-api-key(i);
                                }
                            }
                        }
                    }
                    Hint {
                        text: root.texts.key-hint;
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    SectionTitle {
                        text: root.texts.refresh;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: root.texts.refresh-check;
                            vertical-alignment: center;
                            color: Palette.foreground;
                        }
                        ComboBox {
                            model: root.interval-choices;
                            current-index <=> root.interval-index;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                }

                readout-section := VerticalLayout {
                    spacing: 8px;
                    SectionTitle {
                        text: root.texts.readout;
                    }
                    Switch {
                        text: root.texts.readout-show;
                        checked <=> root.readout-enabled;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: root.texts.readout-rows;
                            vertical-alignment: center;
                            color: Palette.foreground;
                        }
                        ComboBox {
                            model: [root.texts.readout-auto, root.texts.readout-pinned];
                            current-index <=> root.readout-content-index;
                            enabled: root.readout-enabled;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: root.texts.readout-times;
                            vertical-alignment: center;
                            color: Palette.foreground;
                        }
                        ComboBox {
                            model: [root.texts.readout-clock, root.texts.readout-relative];
                            current-index <=> root.time-style-index;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                    Rectangle {
                        border-radius: 4px;
                        border-width: root.focus-pins ? 1px : 0px;
                        border-color: Palette.accent-background;
                        VerticalLayout {
                            padding: root.focus-pins ? 8px : 0px;
                            spacing: 4px;
                            Hint {
                                text: root.texts.meters-hint;
                            }
                            for meter[i] in root.meters: HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: meter.label;
                                    vertical-alignment: center;
                                    color: Palette.foreground;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                CheckBox {
                                    text: root.texts.meter-show;
                                    checked: meter.shown;
                                    toggled => {
                                        root.meter-shown-toggled(i, self.checked);
                                    }
                                }
                                CheckBox {
                                    text: root.texts.meter-pin;
                                    checked: meter.pinned;
                                    enabled: meter.shown && root.readout-content-index == 1;
                                    toggled => {
                                        root.meter-pinned-toggled(i, self.checked);
                                    }
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    SectionTitle {
                        text: root.texts.notify;
                    }
                    Switch {
                        text: root.texts.notify-on;
                        checked <=> root.notify-enabled;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: root.texts.notify-levels;
                            vertical-alignment: center;
                            color: Palette.foreground;
                        }
                        ComboBox {
                            width: 96px;
                            model: root.level-choices;
                            current-index <=> root.notify-first-index;
                            enabled: root.notify-enabled;
                        }
                        Text {
                            text: root.texts.notify-and;
                            vertical-alignment: center;
                            color: Palette.foreground;
                        }
                        ComboBox {
                            width: 96px;
                            model: root.level-choices;
                            current-index <=> root.notify-second-index;
                            enabled: root.notify-enabled;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                    CheckBox {
                        text: root.texts.notify-used-up;
                        checked <=> root.notify-used-up;
                        enabled: root.notify-enabled;
                    }
                    CheckBox {
                        text: root.texts.notify-resets;
                        checked <=> root.notify-resets;
                        enabled: root.notify-enabled;
                    }
                    CheckBox {
                        text: root.texts.notify-low;
                        checked <=> root.notify-low-balance;
                        enabled: root.notify-enabled;
                    }
                    Hint {
                        text: root.texts.notify-hint;
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    SectionTitle {
                        text: root.texts.shortcut;
                    }
                    Switch {
                        text: root.texts.shortcut-on;
                        checked <=> root.hotkey-enabled;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        CheckBox {
                            text: root.texts.shortcut-ctrl;
                            checked <=> root.hotkey-ctrl;
                            enabled: root.hotkey-enabled;
                        }
                        CheckBox {
                            text: root.texts.shortcut-alt;
                            checked <=> root.hotkey-alt;
                            enabled: root.hotkey-enabled;
                        }
                        CheckBox {
                            text: root.texts.shortcut-shift;
                            checked <=> root.hotkey-shift;
                            enabled: root.hotkey-enabled;
                        }
                        CheckBox {
                            text: root.texts.shortcut-win;
                            checked <=> root.hotkey-win;
                            enabled: root.hotkey-enabled;
                        }
                        LineEdit {
                            width: 72px;
                            placeholder-text: root.texts.shortcut-key;
                            text <=> root.hotkey-key;
                            enabled: root.hotkey-enabled;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                    if root.hotkey-error != "": Hint {
                        text: root.hotkey-error;
                        color: Palette.foreground;
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    SectionTitle {
                        text: root.texts.language;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        ComboBox {
                            model: root.language-choices;
                            current-index <=> root.language-index;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                    Hint {
                        text: root.texts.language-hint;
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    SectionTitle {
                        text: root.texts.startup;
                    }
                    Switch {
                        text: root.texts.startup-on;
                        checked <=> root.start-with-windows;
                    }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Palette.border;
        }
        HorizontalLayout {
            padding: 16px;
            spacing: 8px;
            Text {
                text: root.status-text;
                vertical-alignment: center;
                color: Palette.foreground;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Button {
                text: root.texts.apply;
                primary: true;
                clicked => {
                    root.apply();
                }
            }
            Button {
                text: root.texts.close;
                clicked => {
                    root.dismiss();
                }
            }
        }
    }
}
