// The settings window (settings-spec): a navigation pane and four pages of settings cards —
// Services, Display, Notifications, General — with instant apply (settings-spec §5): every change
// is reported to Rust at once (switches, check boxes, combo boxes) or at its commit point
// (aliases, the shortcut), and Rust commits it. There is no Apply and no footer. Every text comes
// from Rust (`texts`, the `settings.*` strings) in the chosen language. API keys (Meshy,
// OpenCode Go, described services) are passed to Rust once and stored in Credential Manager,
// never kept in a property, never shown again and never written to settings.json.
//
// Every editable value lives in Rust or in a property of this window, never only inside a page:
// all four pages stay instantiated (the inactive ones invisible, so out of the Tab order and the
// accessibility tree) and keep their scroll position.

import { Button, CheckBox, LineEdit, ComboBox, ScrollView, Switch, Palette } from "std-widgets.slint";
import { SettingsTheme, SettingsFocusRect, NavItem, GroupHeading, PageNote, StatusNote, CardRow, StackedRow, SettingsCard, ExpanderHeader, InfoBar, SettingsLink } from "settings_controls.slint";
import { GlyphData, ProviderGlyph } from "common.slint";

export { SettingsTheme }

// What a service row's expander holds (settings-spec §4), from the service's capabilities: the
// accounts of a service whose accounts are folders (Claude, Codex), the API key of a service read
// with a key stored here (Meshy, OpenCode Go, described services), or nothing.
export enum ServiceKind { none, accounts, key }

// One service of the service list: its glyph, name, one line on how it is read or its state, on
// or off, and what its expander holds. `block` is its accounts block (an index into
// `account-blocks`), `key-row` its API key row (an index into `api-keys`), -1 when it has none;
// `toggle-label` the expander button's accessible name ("Claude accounts", "Meshy API key").
export struct ProviderRow {
    id: string,
    name: string,
    enabled: bool,
    glyph: GlyphData,
    description: string,
    kind: ServiceKind,
    expanded: bool,
    block: int,
    key-row: int,
    toggle-label: string,
}

// One meter type of a service in the Meters list (settings `hidden_meters`, per service; F§2.2):
// its short name (`5-hour limit`, `Veckogränsen`), shown or hidden, and its check box's
// accessible name (`Show Claude 5-hour limit`).
export struct MeterType {
    label: string,
    shown: bool,
    show-label: string,
}

// A service's card in the Meters list: its glyph and name, and its meter types (Rust updates
// them in place).
export struct MeterGroup {
    name: string,
    glyph: GlyphData,
    types: [MeterType],
}

// The API key of one service: the box's placeholder, whether a key is stored, what the last Save
// or Remove did, the note under it (Credential Manager) and the accessible names of the box, Save
// key and Remove ("Save the Meshy API key"). The key itself is never shown or kept here.
export struct ApiKeyRow {
    placeholder: string,
    stored: bool,
    status: string,
    note: string,
    box-label: string,
    save-label: string,
    remove-label: string,
}

// One account of Claude Code or Codex (accounts-spec §7): its key (`default`, `f-…`: never an
// e-mail address), its name (alias, e-mail or `Account 2`), its folder, who is signed in there,
// its alias, whether it may be removed (not the last one of its service) and the alias box's
// accessible name. Rust updates rows in place; `revision` changes when Rust sets the alias box's
// text (after its edit committed).
export struct AccountRow {
    id: string,
    name: string,
    folder: string,
    status: string,
    alias: string,
    alias-label: string,
    remove-label: string,
    removable: bool,
    revision: int,
}

// A folder found on this PC that is not an account yet (accounts-spec §6).
export struct FoundFolder {
    folder: string,
    status: string,
}

// The accounts of one service, with its folders found on this PC and the line under a new
// account's name box ("Opens Claude Code's sign-in in a terminal."). Set once; its rows change in
// place, and what the last action did is in the window's `block-status`.
export struct AccountBlock {
    accounts: [AccountRow],
    found: [FoundFolder],
    new-note: string,
}

// The window's fixed texts (`settings.*` strings), from Rust.
export struct SettingsTexts {
    title: string,
    page-services: string,
    page-services-description: string,
    page-display: string,
    page-display-description: string,
    page-notifications: string,
    page-general: string,
    accounts-alias: string,
    accounts-alias-none: string,
    accounts-remove: string,
    accounts-found: string,
    accounts-add: string,
    accounts-add-folder: string,
    accounts-new: string,
    accounts-new-open: string,
    accounts-new-name: string,
    accounts-new-create: string,
    accounts-new-cancel: string,
    privacy: string,
    privacy-hide: string,
    privacy-hide-description: string,
    custom: string,
    custom-add: string,
    custom-add-description: string,
    custom-open: string,
    custom-open-label: string,
    key-label: string,
    key-save: string,
    key-remove: string,
    refresh: string,
    refresh-check: string,
    appearance: string,
    theme: string,
    theme-studio: string,
    theme-hint: string,
    theme-folder: string,
    updates: string,
    updates-check: string,
    updates-now: string,
    updates-hint: string,
    version: string,
    readout: string,
    readout-show: string,
    readout-every: string,
    readout-rows: string,
    readout-auto: string,
    readout-pinned: string,
    readout-choosing: string,
    pins-first: string,
    pins-second: string,
    readout-times: string,
    readout-clock: string,
    readout-relative: string,
    meters: string,
    meters-hint: string,
    meters-empty: string,
    meters-empty-link: string,
    notify-on: string,
    notify-levels: string,
    notify-and: string,
    notify-also: string,
    notify-used-up: string,
    notify-resets: string,
    notify-low: string,
    notify-hint: string,
    shortcut: string,
    shortcut-on: string,
    shortcut-ctrl: string,
    shortcut-alt: string,
    shortcut-shift: string,
    shortcut-win: string,
    shortcut-key: string,
    language: string,
    language-hint: string,
    startup-on: string,
    retry: string,
    discard: string,
    not-saved-title: string,
}

// A line saying what went wrong in a card (the shortcut, start with Windows): a live region, so
// a screen reader says it when it appears or changes (settings-spec §8).
component ErrorNote inherits Text {
    font-size: 12px;
    color: SettingsTheme.critical;
    wrap: word-wrap;
    accessible-role: text;
    accessible-live-region: polite;
}

// A row of a grouped card holding one check box with its own label.
component CheckRow inherits Rectangle {
    in property <bool> divider;
    in property <length> indent: 0px;
    min-height: 44px;
    if root.divider: Rectangle {
        y: 0px;
        height: 1px;
        background: SettingsTheme.divider;
    }
    HorizontalLayout {
        padding-left: 16px + root.indent;
        padding-right: 16px;
        padding-top: 8px;
        padding-bottom: 8px;
        alignment: start;
        @children
    }
}

// A pin slot's row (settings-spec §4): its header with its list beside it, the list under the
// header in a narrow column, as wide as the column allows (the choices name a service, an account
// and a meter). Placed by hand, so a resize keeps the list and its focus. A divider above.
component PinSlotRow inherits Rectangle {
    in property <string> header;
    in property <bool> enabled: true;
    in property <bool> narrow;
    in property <length> indent;
    in property <[string]> choices;
    in-out property <int> current-index;
    callback selected(int);
    // The list got or lost the keyboard focus (its open popup counts as the list).
    callback focus-changed(bool);
    public function focus-list() {
        list.focus();
    }
    property <bool> list-focused: list.has-focus;
    changed list-focused => {
        root.focus-changed(self.list-focused);
    }
    property <length> inner: self.width - 32px - root.indent;
    property <length> list-width: root.narrow ? min(self.inner, 360px) : min(340px, self.inner - 16px - 140px);
    height: root.narrow
        ? 10px + label.preferred-height + 8px + list.min-height + 12px
        : max(48px, max(label.preferred-height, list.min-height) + 20px);
    accessible-role: groupbox;
    accessible-label: root.header;

    Rectangle {
        y: 0px;
        height: 1px;
        background: SettingsTheme.divider;
    }
    label := Text {
        x: 16px + root.indent;
        y: root.narrow ? 10px : (parent.height - self.height) / 2;
        width: root.narrow ? parent.inner : parent.inner - root.list-width - 16px;
        height: self.preferred-height;
        text: root.header;
        font-size: 14px;
        color: root.enabled ? SettingsTheme.text-primary : SettingsTheme.text-disabled;
        wrap: word-wrap;
        accessible-role: none;
    }
    list := ComboBox {
        x: root.narrow ? 16px + root.indent : parent.width - 16px - root.list-width;
        y: root.narrow ? label.y + label.height + 8px : (parent.height - self.height) / 2;
        width: root.list-width;
        height: self.min-height;
        model: root.choices;
        current-index <=> root.current-index;
        enabled: root.enabled;
        accessible-label: root.header;
        selected => {
            root.selected(self.current-index);
        }
    }
}

// The keyboard shortcut's keys (settings-spec §4): the modifiers as toggle buttons, the key in a
// box with its label beside them (under them when they do not fit; placed by hand, so a resize
// keeps the box and its focus), then the shortcut they make ("Ctrl + Alt + L"), a live region a
// screen reader says when it changes. Rust composes the preview in the window's language.
component ShortcutEditor inherits Rectangle {
    in property <string> ctrl-label;
    in property <string> alt-label;
    in property <string> shift-label;
    in property <string> win-label;
    in property <string> key-label;
    in property <string> preview;
    in-out property <bool> ctrl;
    in-out property <bool> alt;
    in-out property <bool> shift;
    in-out property <bool> win;
    in-out property <string> key;
    // A toggle or the key changed (Rust reads the window's hotkey-* properties).
    callback edited();
    property <bool> one-line: modifiers.min-width + 24px + key-group.min-width <= self.width;
    height: preview-text.y + preview-text.height;

    modifiers := HorizontalLayout {
        x: 0px;
        y: 0px;
        width: self.min-width;
        height: self.min-height;
        spacing: 4px;
        Button {
            text: root.ctrl-label;
            checkable: true;
            checked <=> root.ctrl;
            clicked => {
                root.edited();
            }
        }
        Button {
            text: root.alt-label;
            checkable: true;
            checked <=> root.alt;
            clicked => {
                root.edited();
            }
        }
        Button {
            text: root.shift-label;
            checkable: true;
            checked <=> root.shift;
            clicked => {
                root.edited();
            }
        }
        Button {
            text: root.win-label;
            checkable: true;
            checked <=> root.win;
            clicked => {
                root.edited();
            }
        }
    }
    key-group := HorizontalLayout {
        x: root.one-line ? modifiers.width + 24px : 0px;
        y: root.one-line ? 0px : modifiers.height + 8px;
        width: self.min-width;
        height: max(modifiers.height, self.min-height);
        spacing: 8px;
        Text {
            text: root.key-label;
            font-size: 14px;
            color: SettingsTheme.text-primary;
            vertical-alignment: center;
            accessible-role: none;
        }
        LineEdit {
            width: 72px;
            accessible-label: root.key-label;
            text <=> root.key;
            edited => {
                root.edited();
            }
        }
    }
    preview-text := Text {
        x: 0px;
        y: key-group.y + key-group.height + 12px;
        width: parent.width;
        height: self.preferred-height;
        text: root.preview;
        font-size: 14px;
        font-weight: 600;
        color: SettingsTheme.text-primary;
        wrap: word-wrap;
        accessible-role: text;
        accessible-live-region: polite;
    }
}

// The first row of a service's card in the Meters list: its glyph and its name.
component ServiceHeaderRow inherits Rectangle {
    in property <string> name;
    in property <GlyphData> glyph;
    min-height: 48px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 16px;
        if root.glyph.commands != "" || root.glyph.monogram != "": VerticalLayout {
            alignment: center;
            ProviderGlyph {
                glyph: root.glyph;
                size: 20px;
                foreground: SettingsTheme.text-primary;
            }
        }
        Text {
            text: root.name;
            font-size: 14px;
            font-weight: 600;
            color: SettingsTheme.text-primary;
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
            accessible-role: none;
        }
    }
}

// A page's title (28 px semibold, Display) and its one-line description.
component PageHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> description;
    padding-top: 28px;
    padding-bottom: 12px;
    spacing: 4px;
    Text {
        text: root.title;
        font-family: SettingsTheme.font-display;
        font-size: 28px;
        font-weight: 600;
        color: SettingsTheme.text-primary;
        wrap: word-wrap;
        accessible-role: text;
    }
    if root.description != "": Text {
        text: root.description;
        font-size: 14px;
        color: SettingsTheme.text-secondary;
        wrap: word-wrap;
    }
}

// A group heading with 24 px above it and 8 px below (with the page's 4 px spacing).
component GroupHeader inherits VerticalLayout {
    in property <string> text;
    in property <string> description;
    padding-top: 20px;
    padding-bottom: 4px;
    spacing: 2px;
    GroupHeading {
        text: root.text;
    }
    if root.description != "": PageNote {
        text: root.description;
    }
}

export component SettingsWindow inherits Window {
    title: root.texts.title;
    preferred-width: 880px;
    preferred-height: 680px;
    min-width: 680px;
    min-height: 520px;
    background: SettingsTheme.page-fill;
    default-font-family: "Segoe UI Variable Text";
    // The pane has the focus when the window opens (as WinUI's NavigationView): without a focused
    // item no key reaches the window, so Ctrl+Tab, the arrow keys and Escape would do nothing
    // until Tab. Its focus rectangle waits for keyboard use.
    forward-focus: nav;

    in property <SettingsTexts> texts;
    // The page shown: 0 Services, 1 Display, 2 Notifications, 3 General.
    in-out property <int> page: 0;

    // ---- Services
    // The services in the settings' order, each with its expander's state (Rust keeps it).
    in property <[ProviderRow]> providers;
    // Claude Code's and Codex's accounts (accounts-spec §7), one block per service, and per block
    // what the last action did.
    in property <[AccountBlock]> account-blocks;
    in property <[string]> block-status;
    // The block whose new account's name box is shown (New account…), -1 for none.
    in-out property <int> new-account-block: -1;
    in-out property <bool> hide-personal-info;
    in property <[ApiKeyRow]> api-keys;

    // ---- Display
    // The themes (themes-spec §3): built-in ones first, then the user's, and the one in use.
    in property <[string]> themes;
    in-out property <int> theme-index;
    // "Show times as" (R§5.2): 0 clock times, 1 time remaining.
    in-out property <int> time-style-index;
    in-out property <bool> readout-enabled;
    in-out property <bool> readout-every;
    // Readout content (R§4.3): 0 auto, 1 pinned meters (or choosing them).
    in-out property <int> readout-content-index;
    // "Meters I choose" without a pin yet: the taskbar stays automatic.
    in property <bool> choosing-pins;
    // The two pin slots (settings-spec §4): what each lists ("None", the shown meters with their
    // account, a saved pin not listed now as "… (not available)") and its choice. The second is
    // off while the first is empty. Rust maps a choice to its meter.
    in property <[string]> pin-first-choices;
    in-out property <int> pin-first-index;
    in property <[string]> pin-second-choices;
    in-out property <int> pin-second-index;
    in property <bool> pin-second-enabled;
    // Under the slots after a pinned meter was hidden.
    in property <string> pin-note;
    // The Meters list: a card per service that is on, a check box per meter type.
    in property <[MeterGroup]> meter-groups;
    // The tray menu's "Pinned meters…" (R§10): an accent outline around the taskbar content's
    // card.
    in property <bool> highlight-pins;

    // ---- Notifications (N§2): on/off, two levels (indices into level-choices: "Off", "50%", …),
    // used up, resets and low balances.
    in-out property <bool> notify-enabled;
    in property <[string]> level-choices;
    in-out property <int> notify-first-index;
    in-out property <int> notify-second-index;
    in-out property <bool> notify-used-up;
    in-out property <bool> notify-resets;
    in-out property <bool> notify-low-balance;

    // ---- General
    in-out property <bool> start-with-windows;
    // Why start with Windows is not what was asked.
    in property <string> startup-error;
    // The language of Lastdrop's texts: index into language-choices ("Same as Windows (…)", then
    // each language by its own name), from Rust.
    in property <[string]> language-choices;
    in-out property <int> language-index;
    // Refresh interval: index into interval-choices ("Manual", "1 min", …), localized by Rust.
    in property <[string]> interval-choices;
    in-out property <int> interval-index;
    // The global hotkey (R§10, off by default): modifiers and one key (a letter, a digit or
    // F1…F24), the shortcut they make ("Ctrl + Alt + L"), the problem to show under it and
    // whether Try again is offered (it was refused).
    in-out property <bool> hotkey-enabled;
    in-out property <bool> hotkey-ctrl;
    in-out property <bool> hotkey-alt;
    in-out property <bool> hotkey-shift;
    in-out property <bool> hotkey-win;
    in-out property <string> hotkey-key;
    in property <string> hotkey-preview;
    in property <string> hotkey-error;
    in property <bool> hotkey-retry;
    // Updates (updates-spec §1): the daily check, and what "Check now" did.
    in-out property <bool> updates-check;
    in property <string> updates-status;

    // ---- The InfoBar (settings-spec §2): the settings could not be saved. `info-closing`: the
    // window was being closed, so "Close without saving" is offered too.
    in property <string> info-text;
    in property <bool> info-closing;

    // Deep link to the accounts (Focus::Accounts): focus the first found folder's Add of
    // `reveal-block` once it is shown.
    in-out property <bool> reveal-found;
    in property <int> reveal-block;

    callback page-changed(int);
    // A service (row) turned on or off; its expander opened or closed.
    callback provider-toggled(int, bool);
    callback service-toggled(int, bool);
    // Accounts: (block, row) of an account or a found folder; a block for the folder picker and
    // for a new account with its name.
    callback account-alias-edited(int, int, string);
    callback account-alias-done(int, int);
    callback account-removed(int, int);
    callback found-added(int, int);
    callback add-folder(int);
    callback new-account(int, string);
    callback privacy-toggled(bool);
    // Store (row, key) and remove (row) an API key.
    callback set-api-key(int, string);
    callback clear-api-key(int);
    // "Add your own service": the folder of described services in File Explorer.
    callback open-providers-folder();
    callback theme-selected(int);
    // Theme Studio, starting from the theme at that index; the themes folder in File Explorer.
    callback open-studio(int);
    callback open-themes-folder();
    callback time-style-selected(int);
    callback readout-enabled-toggled(bool);
    callback readout-every-toggled(bool);
    callback readout-mode-selected(int);
    // A pin slot (0 first, 1 second) picked a choice (an index into its list).
    callback pin-slot-selected(int, int);
    // A list of the taskbar's content (-1 "Taskbar content", 0 and 1 the pin slots) got or lost
    // the keyboard focus: while it has it, Rust measures its picks against the pins it had then.
    callback pin-list-focused(int, bool);
    // A meter type (card, row) of the Meters list shown or hidden.
    callback meter-shown-toggled(int, int, bool);
    callback notify-enabled-toggled(bool);
    callback levels-selected(int, int);
    callback notify-used-up-toggled(bool);
    callback notify-resets-toggled(bool);
    callback notify-low-toggled(bool);
    callback startup-toggled(bool);
    callback language-selected(int);
    callback interval-selected(int);
    // The shortcut editor changed (Rust reads the hotkey-* properties); Try again.
    callback hotkey-edited();
    callback hotkey-retry-clicked();
    callback updates-toggled(bool);
    callback check-updates();
    // The InfoBar's Try again and Close without saving.
    callback info-retry();
    callback info-discard();
    // `close` would shadow Window's builtin close() (Slint 1.18), hence `dismiss`: Escape.
    callback dismiss();

    // Bumped by a deep link to the pins; the first pin slot takes the focus, once it is shown
    // (`pins-focus-pending` until then: the slots come with "Meters I choose").
    property <int> pins-request;
    property <bool> pins-focus-pending;
    // Bumped by a deep link to the accounts.
    property <int> reveal-request;
    // Where the keyboard focus goes when the row holding it went (an account removed, a found
    // folder added; settings-spec §8), in block `focus-block`: the alias box of an account
    // ("account:<key>"), a found folder's Add ("found:<folder>") or Add folder… ("add-folder").
    // Rust sets them and bumps `focus-request`. By the row's data, not its index: rows after the
    // one that went keep their old index until the repeater catches up.
    in property <int> focus-block: -1;
    in property <string> focus-target;
    in property <int> focus-request;

    // The --preview-settings render with --dark. The window itself follows Windows' app mode.
    public function use-dark-scheme() {
        Palette.color-scheme = ColorScheme.dark;
    }

    // A contrast theme: the standard controls draw on its window colour, so their scheme follows
    // it (white text on a dark contrast theme), whatever the app mode says.
    public function use-scheme-for-contrast(dark: bool) {
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    // Shows page `index` (the navigation pane, Ctrl+Tab, a deep link).
    public function select-page(index: int) {
        if (index != root.page && index >= 0 && index < 4) {
            root.page = index;
            root.page-changed(index);
        }
    }

    // Deep link to the readout's pins (tray menu "Taskbar readout ▸ Pinned meters…", R§10):
    // the Display page, scrolled to the taskbar readout, the first pin slot focused.
    public function reveal-pins() {
        root.select-page(1);
        display-sv.content-y = max(
            min(0px, 12px - (readout-heading.absolute-position.y - display-page.absolute-position.y)),
            display-sv.visible-height - display-page.preferred-height);
        root.pins-focus-pending = true;
        root.pins-request += 1;
    }

    // Deep link to the accounts (the first run found more folders, accounts-spec §6): the
    // Services page; once the service of `reveal-block` is expanded (Rust expands it), the page
    // scrolls to it and its first found folder's Add takes the focus. Without a found folder the
    // pane takes it: the focus may be on the page just hidden, where no key reaches the window.
    public function reveal-accounts(focus-found: bool) {
        root.select-page(0);
        root.reveal-found = focus-found;
        root.reveal-request += 1;
        if (!focus-found) {
            nav.focus();
        }
    }

    // Scrolls the Services page so `y` (a position in it) is 12 px below the top.
    function scroll-services-to(y: length) {
        services-sv.content-y = max(min(0px, 12px - y), services-sv.visible-height - services-page.preferred-height);
    }

    // An expander opened: the page scrolls as little as it takes to show its header and content,
    // from `top` to `bottom` (positions in the page), or the header at the top when they do not
    // fit (as WinUI brings an expanded expander into view). Tab skips a box scrolled out of view
    // (a LineEdit clips itself, and Slint's Tab only passes what the scroll view alone hides), so
    // the boxes it opens must be in view.
    function show-services-part(top: length, bottom: length) {
        if (bottom - top + 24px > services-sv.visible-height) {
            root.scroll-services-to(top);
        } else if (bottom + 12px > services-sv.visible-height - services-sv.content-y) {
            root.scroll-services-to(bottom + 24px - services-sv.visible-height);
        }
    }

    // The content column's side padding (its width is at most 720 px).
    property <length> side: content.width < 560px ? 24px : 32px;
    // A narrow column (settings-spec §4): an account's alias box goes under its name and state,
    // rows of a box and its buttons put the buttons under the box, and an expander's rows are
    // indented less. From the pane's width, not the page's, so a scroll bar never changes it.
    property <bool> narrow: min(720px, content.width - 2 * root.side) < 520px;
    property <length> indent: root.narrow ? 16px : 40px;

    keys := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            SettingsTheme.keyboard-focus-visible = true;
            if (event.text == Key.Tab && event.modifiers.control) {
                root.select-page(event.modifiers.shift ? mod(root.page + 3, 4) : mod(root.page + 1, 4));
                // The focus may have been on the page that is hidden now: the pane takes it.
                nav.by-keyboard = true;
                nav.focus();
                return accept;
            }
            reject
        }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismiss();
                return accept;
            }
            reject
        }

        HorizontalLayout {
            // ---- Navigation pane: labelled items, one Tab stop; the arrow keys, Home and End move
            // the selection.
            nav := FocusScope {
                width: 220px;
                property <bool> by-keyboard;
                accessible-role: tab-list;
                accessible-label: root.texts.title;
                focus-changed-event(reason) => {
                    self.by-keyboard = reason == FocusReason.tab-navigation;
                }
                key-pressed(event) => {
                    if (event.text == Key.UpArrow) {
                        root.select-page(max(0, root.page - 1));
                    } else if (event.text == Key.DownArrow) {
                        root.select-page(min(3, root.page + 1));
                    } else if (event.text == Key.Home) {
                        root.select-page(0);
                    } else if (event.text == Key.End) {
                        root.select-page(3);
                    } else {
                        return reject;
                    }
                    self.by-keyboard = true;
                    accept
                }
                VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 12px;
                    spacing: 4px;
                    alignment: start;
                    for item[i] in [
                        { icon: "\u{E753}", label: root.texts.page-services },
                        { icon: "\u{E7F4}", label: root.texts.page-display },
                        { icon: "\u{EA8F}", label: root.texts.page-notifications },
                        { icon: "\u{E713}", label: root.texts.page-general },
                    ]: NavItem {
                        icon: item.icon;
                        label: item.label;
                        index: i;
                        count: 4;
                        selected: root.page == i;
                        focused: nav.has-focus && nav.by-keyboard && root.page == i;
                        clicked => {
                            root.select-page(i);
                            SettingsTheme.keyboard-focus-visible = false;
                            nav.by-keyboard = false;
                            nav.focus();
                        }
                    }
                }
            }

            // ---- Content pane: the InfoBar slot, then the page. Placed by hand, not by a layout,
            // so the side padding (which follows the pane's width) never feeds the window's size.
            content := Rectangle {
                horizontal-stretch: 1;
                property <length> info-height: info.visible ? info.preferred-height + 16px : 0px;
                info := InfoBar {
                    x: root.side;
                    y: 16px;
                    width: parent.width - 2 * root.side;
                    height: self.visible ? self.preferred-height : 0px;
                    visible: root.info-text != "";
                    title: root.texts.not-saved-title;
                    message: root.info-text;
                    has-actions: true;
                    Button {
                        text: root.texts.retry;
                        primary: true;
                        clicked => {
                            root.info-retry();
                        }
                    }
                    if root.info-closing: Button {
                        text: root.texts.discard;
                        clicked => {
                            root.info-discard();
                        }
                    }
                }
                pages := Rectangle {
                    y: content.info-height;
                    width: parent.width;
                    height: parent.height - content.info-height;

                    // ---- Services
                    services-sv := ScrollView {
                        width: parent.width;
                        height: parent.height;
                        visible: root.page == 0;
                        accessible-role: tab-panel;
                        accessible-label: root.texts.page-services;
                        content-width: self.visible-width;
                        content-height: services-page.preferred-height;
                        services-page := HorizontalLayout {
                            width: services-sv.visible-width;
                            padding-left: root.side;
                            padding-right: root.side;
                            padding-bottom: 32px;
                            alignment: start;
                            VerticalLayout {
                                // As wide as the pane allows, up to 720 px, whatever the
                                // page holds (the page's layout places its column at the start).
                                preferred-width: 720px;
                                max-width: 720px;
                                horizontal-stretch: 1;
                                spacing: 4px;
                                alignment: start;
                                PageHeader {
                                    title: root.texts.page-services;
                                    description: root.texts.page-services-description;
                                }
                                // One grouped card of the services; a service with something to
                                // manage expands to its accounts or its API key (settings-spec §4).
                                SettingsCard {
                                    for row[i] in root.providers: VerticalLayout {
                                        service-header := ExpanderHeader {
                                            header: row.name;
                                            description: row.description;
                                            glyph: row.glyph;
                                            divider: i > 0;
                                            last: i == root.providers.length - 1 && !row.expanded;
                                            expandable: row.kind != ServiceKind.none;
                                            expanded: row.expanded;
                                            toggle-label: row.toggle-label;
                                            toggled(on) => {
                                                root.service-toggled(i, on);
                                            }
                                            property <bool> on: row.enabled;
                                            changed on => {
                                                provider-switch.checked = self.on;
                                            }
                                            provider-switch := Switch {
                                                checked: row.enabled;
                                                accessible-label: row.name;
                                                toggled => {
                                                    root.provider-toggled(i, self.checked);
                                                }
                                            }
                                        }

                                        // ---- Claude Code's or Codex's accounts (accounts-spec §7)
                                        if row.expanded && row.kind == ServiceKind.accounts: Rectangle {
                                            init => {
                                                root.show-services-part(
                                                    service-header.absolute-position.y - services-page.absolute-position.y,
                                                    self.absolute-position.y - services-page.absolute-position.y + self.height);
                                            }
                                            VerticalLayout {
                                                for account[a] in root.account-blocks[row.block].accounts: Rectangle {
                                                    // Name, state and folder · Alias and Remove; in a
                                                    // narrow column the alias row goes under them.
                                                    // Placed by hand: the same alias box in both
                                                    // arrangements, so a resize keeps what it holds.
                                                    property <length> pad-left: 16px + root.indent;
                                                    property <length> inner: self.width - self.pad-left - 16px;
                                                    height: root.narrow
                                                        ? 10px + texts.preferred-height + 8px + controls.preferred-height + 10px
                                                        : max(texts.preferred-height, controls.preferred-height) + 20px;
                                                    accessible-role: groupbox;
                                                    accessible-label: account.name;
                                                    accessible-description: account.status + " · " + account.folder;
                                                    property <int> revision: account.revision;
                                                    changed revision => {
                                                        alias-box.text = account.alias;
                                                    }
                                                    property <int> focus-request: root.focus-request;
                                                    changed focus-request => {
                                                        if (root.focus-block == row.block && root.focus-target == "account:" + account.id) {
                                                            alias-box.focus();
                                                        }
                                                    }
                                                    Rectangle {
                                                        y: 0px;
                                                        height: 1px;
                                                        background: SettingsTheme.divider;
                                                    }
                                                    texts := VerticalLayout {
                                                        x: parent.pad-left;
                                                        y: root.narrow ? 10px : (parent.height - self.height) / 2;
                                                        width: root.narrow ? parent.inner : parent.inner - controls.width - 16px;
                                                        height: self.preferred-height;
                                                        spacing: 2px;
                                                        Text {
                                                            text: account.name;
                                                            font-size: 14px;
                                                            font-weight: 600;
                                                            color: SettingsTheme.text-primary;
                                                            wrap: word-wrap;
                                                            accessible-role: none;
                                                        }
                                                        Text {
                                                            text: account.status;
                                                            font-size: 14px;
                                                            color: SettingsTheme.text-primary;
                                                            wrap: word-wrap;
                                                            accessible-role: none;
                                                        }
                                                        Text {
                                                            text: account.folder;
                                                            font-size: 12px;
                                                            color: SettingsTheme.text-secondary;
                                                            overflow: elide;
                                                            accessible-role: none;
                                                        }
                                                    }
                                                    controls := HorizontalLayout {
                                                        x: root.narrow ? parent.pad-left : parent.width - 16px - self.width;
                                                        y: root.narrow ? texts.y + texts.height + 8px : (parent.height - self.height) / 2;
                                                        width: root.narrow ? parent.inner : self.preferred-width;
                                                        height: self.preferred-height;
                                                        spacing: 8px;
                                                        Text {
                                                            text: root.texts.accounts-alias;
                                                            font-size: 14px;
                                                            color: SettingsTheme.text-primary;
                                                            horizontal-stretch: 0;
                                                            vertical-alignment: center;
                                                            accessible-role: none;
                                                        }
                                                        alias-box := LineEdit {
                                                            text: account.alias;
                                                            placeholder-text: root.texts.accounts-alias-none;
                                                            accessible-label: account.alias-label;
                                                            preferred-width: 160px;
                                                            horizontal-stretch: 1;
                                                            edited(text) => {
                                                                root.account-alias-edited(row.block, a, text);
                                                            }
                                                            accepted(text) => {
                                                                root.account-alias-done(row.block, a);
                                                            }
                                                            changed has-focus => {
                                                                if (!self.has-focus) {
                                                                    root.account-alias-done(row.block, a);
                                                                }
                                                            }
                                                        }
                                                        if account.removable: Button {
                                                            text: root.texts.accounts-remove;
                                                            accessible-label: account.remove-label;
                                                            clicked => {
                                                                root.account-removed(row.block, a);
                                                            }
                                                        }
                                                    }
                                                }
                                                if root.account-blocks[row.block].found.length > 0: StackedRow {
                                                    header: root.texts.accounts-found;
                                                    divider: true;
                                                    indent: root.indent;
                                                }
                                                for found[f] in root.account-blocks[row.block].found: CardRow {
                                                    header: found.folder;
                                                    description: found.status;
                                                    indent: root.indent;
                                                    property <int> request: root.reveal-request;
                                                    // The accounts deep link: this service at the top,
                                                    // its first found folder's Add focused.
                                                    function take-reveal() {
                                                        if (root.reveal-found && root.reveal-block == row.block && f == 0) {
                                                            root.reveal-found = false;
                                                            root.scroll-services-to(service-header.absolute-position.y - services-page.absolute-position.y);
                                                            add-found.focus();
                                                        }
                                                    }
                                                    changed request => {
                                                        self.take-reveal();
                                                    }
                                                    init => {
                                                        self.take-reveal();
                                                    }
                                                    property <int> focus-request: root.focus-request;
                                                    changed focus-request => {
                                                        if (root.focus-block == row.block && root.focus-target == "found:" + found.folder) {
                                                            add-found.focus();
                                                        }
                                                    }
                                                    add-found := Button {
                                                        text: root.texts.accounts-add;
                                                        accessible-label: root.texts.accounts-add + " " + found.folder;
                                                        clicked => {
                                                            root.found-added(row.block, f);
                                                        }
                                                    }
                                                }
                                                Rectangle {
                                                    Rectangle {
                                                        y: 0px;
                                                        height: 1px;
                                                        background: SettingsTheme.divider;
                                                    }
                                                    FlexboxLayout {
                                                        padding-left: 16px + root.indent;
                                                        padding-right: 16px;
                                                        padding-top: 12px;
                                                        padding-bottom: 12px;
                                                        spacing: 8px;
                                                        add-folder := Button {
                                                            text: root.texts.accounts-add-folder;
                                                            property <int> focus-request: root.focus-request;
                                                            changed focus-request => {
                                                                if (root.focus-block == row.block && root.focus-target == "add-folder") {
                                                                    self.focus();
                                                                }
                                                            }
                                                            clicked => {
                                                                root.add-folder(row.block);
                                                            }
                                                        }
                                                        new-account := Button {
                                                            text: root.texts.accounts-new-open;
                                                            clicked => {
                                                                root.new-account-block = row.block;
                                                            }
                                                        }
                                                    }
                                                }
                                                // New account…: a name box, Create and sign in, Cancel.
                                                if root.new-account-block == row.block: StackedRow {
                                                    header: root.texts.accounts-new;
                                                    description: root.account-blocks[row.block].new-note;
                                                    divider: true;
                                                    indent: root.indent;
                                                    init => {
                                                        new-name.focus();
                                                    }
                                                    FlexboxLayout {
                                                        spacing: 8px;
                                                        flex-direction: root.narrow ? FlexboxLayoutDirection.column : FlexboxLayoutDirection.row;
                                                        flex-wrap: FlexboxLayoutWrap.no-wrap;
                                                        alignment: stretch;
                                                        cross-axis-alignment: root.narrow ? CrossAxisAlignment.stretch : CrossAxisAlignment.center;
                                                        new-name := LineEdit {
                                                            placeholder-text: root.texts.accounts-new-name;
                                                            accessible-label: root.texts.accounts-new;
                                                            min-width: 160px;
                                                            horizontal-stretch: 1;
                                                            accepted(text) => {
                                                                if (text != "") {
                                                                    root.new-account(row.block, text);
                                                                    self.text = "";
                                                                    root.new-account-block = -1;
                                                                    new-account.focus();
                                                                }
                                                            }
                                                        }
                                                        HorizontalLayout {
                                                            horizontal-stretch: 0;
                                                            alignment: start;
                                                            spacing: 8px;
                                                            Button {
                                                                text: root.texts.accounts-new-create;
                                                                enabled: new-name.text != "";
                                                                clicked => {
                                                                    root.new-account(row.block, new-name.text);
                                                                    new-name.text = "";
                                                                    root.new-account-block = -1;
                                                                    new-account.focus();
                                                                }
                                                            }
                                                            Button {
                                                                text: root.texts.accounts-new-cancel;
                                                                clicked => {
                                                                    root.new-account-block = -1;
                                                                    new-account.focus();
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                                if root.block-status[row.block] != "": HorizontalLayout {
                                                    padding-left: 16px + root.indent;
                                                    padding-right: 16px;
                                                    padding-bottom: 12px;
                                                    StatusNote {
                                                        text: root.block-status[row.block];
                                                    }
                                                }
                                            }
                                        }

                                        // ---- The service's API key (settings-spec §5.6)
                                        if row.expanded && row.kind == ServiceKind.key: StackedRow {
                                            header: root.texts.key-label;
                                            divider: true;
                                            indent: root.indent;
                                            init => {
                                                root.show-services-part(
                                                    service-header.absolute-position.y - services-page.absolute-position.y,
                                                    self.absolute-position.y - services-page.absolute-position.y + self.height);
                                            }
                                            // A key typed but not saved is not kept when the page
                                            // changes (nor when the expander closes: the box goes).
                                            property <int> shown-page: root.page;
                                            changed shown-page => {
                                                key-box.text = "";
                                            }
                                            FlexboxLayout {
                                                spacing: 8px;
                                                flex-direction: root.narrow ? FlexboxLayoutDirection.column : FlexboxLayoutDirection.row;
                                                flex-wrap: FlexboxLayoutWrap.no-wrap;
                                                alignment: stretch;
                                                cross-axis-alignment: root.narrow ? CrossAxisAlignment.stretch : CrossAxisAlignment.center;
                                                key-box := LineEdit {
                                                    placeholder-text: root.api-keys[row.key-row].placeholder;
                                                    accessible-label: root.api-keys[row.key-row].box-label;
                                                    input-type: password;
                                                    min-width: 160px;
                                                    horizontal-stretch: 1;
                                                    accepted => {
                                                        if (self.text != "") {
                                                            root.set-api-key(row.key-row, self.text);
                                                            self.text = "";
                                                        }
                                                    }
                                                }
                                                HorizontalLayout {
                                                    horizontal-stretch: 0;
                                                    alignment: start;
                                                    spacing: 8px;
                                                    Button {
                                                        text: root.texts.key-save;
                                                        accessible-label: root.api-keys[row.key-row].save-label;
                                                        enabled: key-box.text != "";
                                                        clicked => {
                                                            root.set-api-key(row.key-row, key-box.text);
                                                            key-box.text = "";
                                                        }
                                                    }
                                                    if root.api-keys[row.key-row].stored: Button {
                                                        text: root.texts.key-remove;
                                                        accessible-label: root.api-keys[row.key-row].remove-label;
                                                        // The button goes with the key: the
                                                        // focus goes back to the box.
                                                        clicked => {
                                                            root.clear-api-key(row.key-row);
                                                            key-box.focus();
                                                        }
                                                    }
                                                }
                                            }
                                            if root.api-keys[row.key-row].status != "": StatusNote {
                                                text: root.api-keys[row.key-row].status;
                                            }
                                            PageNote {
                                                text: root.api-keys[row.key-row].note;
                                            }
                                        }
                                    }
                                }

                                GroupHeader {
                                    text: root.texts.privacy;
                                }
                                SettingsCard {
                                    CardRow {
                                        header: root.texts.privacy-hide;
                                        description: root.texts.privacy-hide-description;
                                        Switch {
                                            checked <=> root.hide-personal-info;
                                            accessible-label: root.texts.privacy-hide;
                                            toggled => {
                                                root.privacy-toggled(self.checked);
                                            }
                                        }
                                    }
                                }

                                GroupHeader {
                                    text: root.texts.custom;
                                }
                                SettingsCard {
                                    CardRow {
                                        header: root.texts.custom-add;
                                        description: root.texts.custom-add-description;
                                        Button {
                                            text: root.texts.custom-open;
                                            accessible-label: root.texts.custom-open-label;
                                            clicked => {
                                                root.open-providers-folder();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ---- Display
                    display-sv := ScrollView {
                        width: parent.width;
                        height: parent.height;
                        visible: root.page == 1;
                        accessible-role: tab-panel;
                        accessible-label: root.texts.page-display;
                        content-width: self.visible-width;
                        content-height: display-page.preferred-height;
                        display-page := HorizontalLayout {
                            width: display-sv.visible-width;
                            padding-left: root.side;
                            padding-right: root.side;
                            padding-bottom: 32px;
                            alignment: start;
                            VerticalLayout {
                                // As wide as the pane allows, up to 720 px, whatever the
                                // page holds (the page's layout places its column at the start).
                                preferred-width: 720px;
                                max-width: 720px;
                                horizontal-stretch: 1;
                                spacing: 4px;
                                alignment: start;
                                PageHeader {
                                    title: root.texts.page-display;
                                    description: root.texts.page-display-description;
                                }
                                GroupHeader {
                                    text: root.texts.appearance;
                                }
                                // The theme: its list and Theme Studio… beside the texts (under
                                // them in a narrow column), the themes folder under the texts.
                                // Placed by hand: the same controls in both arrangements, so a
                                // resize keeps the focus, and Tab goes list, Theme Studio…,
                                // folder.
                                SettingsCard {
                                    Rectangle {
                                        property <length> inner: self.width - 32px;
                                        height: root.narrow
                                            ? 12px + theme-texts.preferred-height + 8px + theme-controls.preferred-height + 6px + theme-folder.preferred-height + 12px
                                            : max(theme-texts.preferred-height + 4px + theme-folder.preferred-height, theme-controls.preferred-height) + 24px;
                                        accessible-role: groupbox;
                                        accessible-label: root.texts.theme;
                                        accessible-description: root.texts.theme-hint;
                                        theme-texts := VerticalLayout {
                                            x: 16px;
                                            y: 12px;
                                            width: root.narrow ? parent.inner : parent.inner - theme-controls.width - 16px;
                                            height: self.preferred-height;
                                            spacing: 2px;
                                            Text {
                                                text: root.texts.theme;
                                                font-size: 14px;
                                                color: SettingsTheme.text-primary;
                                                wrap: word-wrap;
                                                accessible-role: none;
                                            }
                                            Text {
                                                text: root.texts.theme-hint;
                                                font-size: 12px;
                                                color: SettingsTheme.text-secondary;
                                                wrap: word-wrap;
                                                accessible-role: none;
                                            }
                                        }
                                        theme-controls := HorizontalLayout {
                                            x: root.narrow ? 16px : parent.width - 16px - self.width;
                                            y: root.narrow ? theme-texts.y + theme-texts.height + 8px : (parent.height - self.height) / 2;
                                            width: self.preferred-width;
                                            height: self.preferred-height;
                                            spacing: 8px;
                                            ComboBox {
                                                width: 200px;
                                                model: root.themes;
                                                current-index <=> root.theme-index;
                                                accessible-label: root.texts.theme;
                                                selected => {
                                                    root.theme-selected(self.current-index);
                                                }
                                            }
                                            Button {
                                                text: root.texts.theme-studio;
                                                clicked => {
                                                    root.open-studio(root.theme-index);
                                                }
                                            }
                                        }
                                        theme-folder := SettingsLink {
                                            x: 16px;
                                            y: root.narrow ? theme-controls.y + theme-controls.height + 6px : theme-texts.y + theme-texts.height + 4px;
                                            text: root.texts.theme-folder;
                                            clicked => {
                                                root.open-themes-folder();
                                            }
                                        }
                                    }
                                }
                                SettingsCard {
                                    CardRow {
                                        header: root.texts.readout-times;
                                        ComboBox {
                                            model: [root.texts.readout-clock, root.texts.readout-relative];
                                            current-index <=> root.time-style-index;
                                            accessible-label: root.texts.readout-times;
                                            selected => {
                                                root.time-style-selected(self.current-index);
                                            }
                                        }
                                    }
                                }

                                readout-heading := GroupHeader {
                                    text: root.texts.readout;
                                }
                                SettingsCard {
                                    CardRow {
                                        header: root.texts.readout-show;
                                        Switch {
                                            checked <=> root.readout-enabled;
                                            accessible-label: root.texts.readout-show;
                                            toggled => {
                                                root.readout-enabled-toggled(self.checked);
                                            }
                                        }
                                    }
                                }
                                SettingsCard {
                                    CardRow {
                                        header: root.texts.readout-every;
                                        enabled: root.readout-enabled;
                                        Switch {
                                            checked <=> root.readout-every;
                                            enabled: root.readout-enabled;
                                            accessible-label: root.texts.readout-every;
                                            toggled => {
                                                root.readout-every-toggled(self.checked);
                                            }
                                        }
                                    }
                                }
                                // The taskbar's content and, with "Meters I choose", the two pin
                                // slots under it (settings-spec §4); the deep link's target.
                                SettingsCard {
                                    highlighted: root.highlight-pins;
                                    StackedRow {
                                        header: root.texts.readout-rows;
                                        enabled: root.readout-enabled;
                                        HorizontalLayout {
                                            alignment: start;
                                            ComboBox {
                                                model: [root.texts.readout-auto, root.texts.readout-pinned];
                                                current-index <=> root.readout-content-index;
                                                enabled: root.readout-enabled;
                                                accessible-label: root.texts.readout-rows;
                                                selected => {
                                                    root.readout-mode-selected(self.current-index);
                                                }
                                                property <bool> focused: self.has-focus;
                                                changed focused => {
                                                    root.pin-list-focused(-1, self.focused);
                                                }
                                            }
                                        }
                                    }
                                    if root.readout-content-index == 1: VerticalLayout {
                                        PinSlotRow {
                                            header: root.texts.pins-first;
                                            enabled: root.readout-enabled;
                                            narrow: root.narrow;
                                            indent: root.indent;
                                            choices: root.pin-first-choices;
                                            current-index <=> root.pin-first-index;
                                            selected(index) => {
                                                root.pin-slot-selected(0, index);
                                            }
                                            focus-changed(focused) => {
                                                root.pin-list-focused(0, focused);
                                            }
                                            // The deep link focuses the first slot, also when
                                            // it came with the link's "Meters I choose".
                                            init => {
                                                if (root.pins-focus-pending) {
                                                    root.pins-focus-pending = false;
                                                    self.focus-list();
                                                }
                                            }
                                            property <int> request: root.pins-request;
                                            changed request => {
                                                if (root.pins-focus-pending) {
                                                    root.pins-focus-pending = false;
                                                    self.focus-list();
                                                }
                                            }
                                        }
                                        PinSlotRow {
                                            header: root.texts.pins-second;
                                            enabled: root.readout-enabled && root.pin-second-enabled;
                                            narrow: root.narrow;
                                            indent: root.indent;
                                            choices: root.pin-second-choices;
                                            current-index <=> root.pin-second-index;
                                            selected(index) => {
                                                root.pin-slot-selected(1, index);
                                            }
                                            focus-changed(focused) => {
                                                root.pin-list-focused(1, focused);
                                            }
                                        }
                                        if root.choosing-pins || root.pin-note != "": VerticalLayout {
                                            padding-left: 16px + root.indent;
                                            padding-right: 16px;
                                            padding-bottom: 12px;
                                            spacing: 4px;
                                            if root.choosing-pins: PageNote {
                                                text: root.texts.readout-choosing;
                                            }
                                            if root.pin-note != "": StatusNote {
                                                text: root.pin-note;
                                            }
                                        }
                                    }
                                }

                                // A card per service that is on, a check box per meter type:
                                // visibility is per service, as the settings keep it.
                                GroupHeader {
                                    text: root.texts.meters;
                                    description: root.texts.meters-hint;
                                }
                                if root.meter-groups.length == 0: SettingsCard {
                                    CardRow {
                                        header: root.texts.meters-empty;
                                        SettingsLink {
                                            text: root.texts.meters-empty-link;
                                            clicked => {
                                                root.select-page(0);
                                                nav.focus();
                                            }
                                        }
                                    }
                                }
                                for group[g] in root.meter-groups: SettingsCard {
                                    accessible-role: groupbox;
                                    accessible-label: group.name;
                                    ServiceHeaderRow {
                                        name: group.name;
                                        glyph: group.glyph;
                                    }
                                    for type[t] in group.types: CheckRow {
                                        divider: true;
                                        indent: root.indent;
                                        property <bool> shown: type.shown;
                                        changed shown => {
                                            show-box.checked = self.shown;
                                        }
                                        show-box := CheckBox {
                                            text: type.label;
                                            checked: type.shown;
                                            accessible-label: type.show-label;
                                            toggled => {
                                                root.meter-shown-toggled(g, t, self.checked);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ---- Notifications (no expander: everything is visible)
                    notifications-sv := ScrollView {
                        width: parent.width;
                        height: parent.height;
                        visible: root.page == 2;
                        accessible-role: tab-panel;
                        accessible-label: root.texts.page-notifications;
                        content-width: self.visible-width;
                        content-height: notifications-page.preferred-height;
                        notifications-page := HorizontalLayout {
                            width: notifications-sv.visible-width;
                            padding-left: root.side;
                            padding-right: root.side;
                            padding-bottom: 32px;
                            alignment: start;
                            VerticalLayout {
                                // As wide as the pane allows, up to 720 px, whatever the
                                // page holds (the page's layout places its column at the start).
                                preferred-width: 720px;
                                max-width: 720px;
                                horizontal-stretch: 1;
                                spacing: 4px;
                                alignment: start;
                                PageHeader {
                                    title: root.texts.page-notifications;
                                }
                                SettingsCard {
                                    CardRow {
                                        header: root.texts.notify-on;
                                        description: root.texts.notify-hint;
                                        Switch {
                                            checked <=> root.notify-enabled;
                                            accessible-label: root.texts.notify-on;
                                            toggled => {
                                                root.notify-enabled-toggled(self.checked);
                                            }
                                        }
                                    }
                                }
                                SettingsCard {
                                    StackedRow {
                                        header: root.texts.notify-levels;
                                        enabled: root.notify-enabled;
                                        HorizontalLayout {
                                            alignment: start;
                                            spacing: 8px;
                                            ComboBox {
                                                width: 112px;
                                                model: root.level-choices;
                                                current-index <=> root.notify-first-index;
                                                enabled: root.notify-enabled;
                                                accessible-label: root.texts.notify-levels;
                                                selected => {
                                                    root.levels-selected(root.notify-first-index, root.notify-second-index);
                                                }
                                            }
                                            Text {
                                                text: root.texts.notify-and;
                                                font-size: 14px;
                                                color: root.notify-enabled ? SettingsTheme.text-primary : SettingsTheme.text-disabled;
                                                vertical-alignment: center;
                                            }
                                            ComboBox {
                                                width: 112px;
                                                model: root.level-choices;
                                                current-index <=> root.notify-second-index;
                                                enabled: root.notify-enabled;
                                                accessible-label: root.texts.notify-levels + " " + root.texts.notify-and;
                                                selected => {
                                                    root.levels-selected(root.notify-first-index, root.notify-second-index);
                                                }
                                            }
                                        }
                                    }
                                }
                                GroupHeader {
                                    text: root.texts.notify-also;
                                }
                                SettingsCard {
                                    CheckRow {
                                        CheckBox {
                                            text: root.texts.notify-used-up;
                                            checked <=> root.notify-used-up;
                                            enabled: root.notify-enabled;
                                            toggled => {
                                                root.notify-used-up-toggled(self.checked);
                                            }
                                        }
                                    }
                                    CheckRow {
                                        divider: true;
                                        CheckBox {
                                            text: root.texts.notify-resets;
                                            checked <=> root.notify-resets;
                                            enabled: root.notify-enabled;
                                            toggled => {
                                                root.notify-resets-toggled(self.checked);
                                            }
                                        }
                                    }
                                    CheckRow {
                                        divider: true;
                                        CheckBox {
                                            text: root.texts.notify-low;
                                            checked <=> root.notify-low-balance;
                                            enabled: root.notify-enabled;
                                            toggled => {
                                                root.notify-low-toggled(self.checked);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ---- General
                    general-sv := ScrollView {
                        width: parent.width;
                        height: parent.height;
                        visible: root.page == 3;
                        accessible-role: tab-panel;
                        accessible-label: root.texts.page-general;
                        content-width: self.visible-width;
                        content-height: general-page.preferred-height;
                        general-page := HorizontalLayout {
                            width: general-sv.visible-width;
                            padding-left: root.side;
                            padding-right: root.side;
                            padding-bottom: 32px;
                            alignment: start;
                            VerticalLayout {
                                // As wide as the pane allows, up to 720 px, whatever the
                                // page holds (the page's layout places its column at the start).
                                preferred-width: 720px;
                                max-width: 720px;
                                horizontal-stretch: 1;
                                spacing: 4px;
                                alignment: start;
                                PageHeader {
                                    title: root.texts.page-general;
                                }
                                SettingsCard {
                                    CardRow {
                                        header: root.texts.startup-on;
                                        Switch {
                                            checked <=> root.start-with-windows;
                                            accessible-label: root.texts.startup-on;
                                            toggled => {
                                                root.startup-toggled(self.checked);
                                            }
                                        }
                                    }
                                    if root.startup-error != "": HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        padding-bottom: 12px;
                                        ErrorNote {
                                            text: root.startup-error;
                                        }
                                    }
                                }
                                SettingsCard {
                                    // Under its text: "Same as Windows (Svenska)" is too wide to
                                    // share a line with it at the smallest size.
                                    StackedRow {
                                        header: root.texts.language;
                                        description: root.texts.language-hint;
                                        HorizontalLayout {
                                            alignment: start;
                                            ComboBox {
                                                min-width: 240px;
                                                model: root.language-choices;
                                                current-index <=> root.language-index;
                                                accessible-label: root.texts.language;
                                                selected => {
                                                    root.language-selected(self.current-index);
                                                }
                                            }
                                        }
                                    }
                                }
                                SettingsCard {
                                    CardRow {
                                        header: root.texts.refresh;
                                        description: root.texts.refresh-check;
                                        ComboBox {
                                            model: root.interval-choices;
                                            current-index <=> root.interval-index;
                                            accessible-label: root.texts.refresh;
                                            selected => {
                                                root.interval-selected(self.current-index);
                                            }
                                        }
                                    }
                                }
                                SettingsCard {
                                    CardRow {
                                        header: root.texts.shortcut;
                                        description: root.texts.shortcut-on;
                                        Switch {
                                            checked <=> root.hotkey-enabled;
                                            accessible-label: root.texts.shortcut;
                                            toggled => {
                                                root.hotkey-edited();
                                            }
                                        }
                                    }
                                    if root.hotkey-enabled: StackedRow {
                                        divider: true;
                                        ShortcutEditor {
                                            ctrl-label: root.texts.shortcut-ctrl;
                                            alt-label: root.texts.shortcut-alt;
                                            shift-label: root.texts.shortcut-shift;
                                            win-label: root.texts.shortcut-win;
                                            key-label: root.texts.shortcut-key;
                                            preview: root.hotkey-preview;
                                            ctrl <=> root.hotkey-ctrl;
                                            alt <=> root.hotkey-alt;
                                            shift <=> root.hotkey-shift;
                                            win <=> root.hotkey-win;
                                            key <=> root.hotkey-key;
                                            edited => {
                                                root.hotkey-edited();
                                            }
                                        }
                                        if root.hotkey-error != "": HorizontalLayout {
                                            spacing: 12px;
                                            ErrorNote {
                                                horizontal-stretch: 1;
                                                vertical-alignment: center;
                                                text: root.hotkey-error;
                                            }
                                            if root.hotkey-retry: Button {
                                                text: root.texts.retry;
                                                clicked => {
                                                    root.hotkey-retry-clicked();
                                                }
                                            }
                                        }
                                    }
                                }
                                GroupHeader {
                                    text: root.texts.updates;
                                }
                                SettingsCard {
                                    CardRow {
                                        header: root.texts.updates-check;
                                        description: root.texts.updates-hint;
                                        Switch {
                                            checked <=> root.updates-check;
                                            accessible-label: root.texts.updates-check;
                                            toggled => {
                                                root.updates-toggled(self.checked);
                                            }
                                        }
                                    }
                                }
                                SettingsCard {
                                    CardRow {
                                        header: root.texts.version;
                                        description: root.updates-status;
                                        Button {
                                            text: root.texts.updates-now;
                                            clicked => {
                                                root.check-updates();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
