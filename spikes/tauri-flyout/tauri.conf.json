{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lastdrop Spike",
  "mainBinaryName": "lastdrop-tauri",
  "version": "0.1.0",
  "identifier": "se.twofivers.lastdrop.spike",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
